body{
    margin:0;
    height:100vh;
    background: radial-gradient(circle at center, #1a0000, #000);
    font-family: 'Cinzel', serif;
    color:#e0c080;
    overflow:hidden;
}

/* háttér glow */
body::before{
    content:"";
    position:fixed;
    width:200%;
    height:200%;
    background: radial-gradient(circle, rgba(255,0,0,0.1), transparent 70%);
    animation: moveBg 10s linear infinite;
}

@keyframes moveBg{
    0%{ transform: translate(0,0); }
    50%{ transform: translate(-10%, -10%); }
    100%{ transform: translate(0,0); }
}

/* layout */
.menu{
    display:flex;
    width:100%;
    height:100vh;
}

/* sidebar */
.sidebar{
    width:220px;
    background: linear-gradient(180deg, #2b2b2b, #111);
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    gap:15px;
}

/* gombok */
.sidebar button{
    width:180px;
    padding:12px;
    background:#1a1a1a;
    border:2px solid #552200;
    color:#e0c080;
    cursor:pointer;
    transition:0.3s;

    animation: fireGlow 2s infinite;
}

.sidebar button:hover{
    background:#330000;
    transform:translateX(5px);
    box-shadow:0 0 15px rgba(255,80,0,0.6);
}

@keyframes fireGlow {
    0%   { box-shadow: 0 0 5px rgba(255,80,0,0.2); }
    50%  { box-shadow: 0 0 20px rgba(255,80,0,0.6); }
    100% { box-shadow: 0 0 5px rgba(255,80,0,0.2); }
}

/* main */
.main{
    flex:1;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
}

.main img{
    max-width:400px;
    animation: float 3s infinite ease-in-out;
}

@keyframes float{
    0%,100%{ transform:translateY(0); }
    50%{ transform:translateY(-10px); }
}

/* input */
.main input{
    margin-top:20px;
    padding:12px;
    background:#111;
    color:white;
    border:1px solid #555;
}

/* canvas */
#gameCanvas{
    display:none;
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
}

/* discord */
.discordBtn{
    position:fixed;
    bottom:20px;
    left:20px;
}

/* 🔥 PARÁZS */
.embers{
    position:fixed;
    bottom:0;
    left:0;
    width:100%;
    height:200px;
    pointer-events:none;
    overflow:hidden;
}

.ember{
    position:absolute;
    bottom:0;
    border-radius:50%;
    opacity:0.8;
    box-shadow:0 0 10px rgba(255,120,0,0.8);
    animation: rise linear forwards;
}

@keyframes rise {
    0% {
        transform: translate(0, 0) scale(1);
        opacity: 1;
    }
    100% {
        transform: translate(
            calc(-20px + 40px * var(--drift)),
            -200px
        ) scale(0.5);
        opacity: 0;
    }
}